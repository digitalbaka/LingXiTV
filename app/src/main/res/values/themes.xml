<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LingXiTV" parent="@style/Theme.Leanback">
        <item name="colorPrimary">@color/lingxi_green</item>
        <item name="colorPrimaryDark">@color/lingxi_green_dark</item>
        <item name="colorAccent">@color/lingxi_green_light</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <!-- Leanback 主题未定义 alertDialogTheme，缺省会让 AlertDialog.Builder 解析到 Resource ID #0x0 直接闪退。
             所有页面的弹窗（关于本站、弹幕设置、清除缓存等）都依赖这里 -->
        <item name="alertDialogTheme">@style/Theme.LingXiTV.Dialog</item>
    </style>

    <style name="Theme.LingXiTV.NoActionBar" parent="Theme.LingXiTV">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.LingXiTV.Player" parent="Theme.LingXiTV.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 显式指定对话框主题，避免 Leanback 主题未定义 alertDialogTheme 导致 Resource ID #0x0 崩溃 -->
        <item name="alertDialogTheme">@style/Theme.LingXiTV.Dialog</item>
    </style>

    <!-- 电视端弹窗使用深色底，与整体深色主题一致，避免大面积白色刺眼 -->
    <style name="Theme.LingXiTV.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/lingxi_green</item>
        <item name="colorPrimaryDark">@color/lingxi_green_dark</item>
        <item name="colorAccent">@color/lingxi_green_light</item>
    </style>

</resources>
