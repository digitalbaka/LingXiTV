<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="凌汐弹幕网"
            android:textColor="@color/lingxi_green_light"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电视版登录"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <!-- 账号密码登录区 -->
        <LinearLayout
            android:id="@+id/loginForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="480dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入账号"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@android:color/white"
                android:padding="12dp"
                android:singleLine="true"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入密码"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@android:color/white"
                android:padding="12dp"
                android:singleLine="true"
                android:inputType="textPassword"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="登录"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/lingxi_green"
                android:padding="14dp"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 二次验证区 -->
        <LinearLayout
            android:id="@+id/twoFactorForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="480dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTwoFactorHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测到这台设备尚未通过验证，请输入发送到邮箱的验证码完成登录。"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- 图形验证码 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="图形验证码"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <WebView
                    android:id="@+id/wvCaptcha"
                    android:layout_width="160dp"
                    android:layout_height="56dp"
                    android:background="@android:color/white" />

                <EditText
                    android:id="@+id/etCaptcha"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:hint="输入图中字符"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:background="@android:color/white"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btnRefreshCaptcha"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="刷新"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 邮箱验证码 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="邮箱验证码"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etEmailCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="6 位数字"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:background="@android:color/white"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:inputType="number" />

                <Button
                    android:id="@+id/btnSendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送验证码"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记住这台设备，30天内不再需要验证码"
                android:textColor="@color/text_secondary"
                android:checked="true"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="验证并登录"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/lingxi_green"
                android:padding="14dp"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lingxi_green_light"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
